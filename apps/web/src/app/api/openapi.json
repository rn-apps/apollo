{
  "components": {
    "schemas": {
      "CheckResult": {
        "description": "One dependency's verdict.",
        "properties": {
          "details": {
            "additionalProperties": true,
            "title": "Details",
            "type": "object"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          },
          "remediation": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Remediation"
          },
          "status": {
            "$ref": "#/components/schemas/CheckStatus"
          }
        },
        "required": [
          "status"
        ],
        "title": "CheckResult",
        "type": "object"
      },
      "CheckStatus": {
        "enum": [
          "pass",
          "warn",
          "fail",
          "skipped"
        ],
        "type": "string"
      },
      "HealthReport": {
        "description": "The aggregate of one readiness run.\n\n``http_status`` is the transport status to serve; it is not part of the body.",
        "properties": {
          "checks": {
            "additionalProperties": {
              "$ref": "#/components/schemas/CheckResult"
            },
            "title": "Checks",
            "type": "object"
          },
          "status": {
            "$ref": "#/components/schemas/CheckStatus"
          }
        },
        "required": [
          "status",
          "checks"
        ],
        "title": "HealthReport",
        "type": "object"
      },
      "ProblemDetail": {
        "additionalProperties": true,
        "description": "An RFC 9457 problem.\n\nExtension members are **flattened at the top level on the wire** (RFC 9457\n\u00a73.2): the model allows extra members, and ``ProblemDetail(...,\nextensions={...})`` merges a mapping in as extras. Core members win a\ncollision with an extension of the same name.",
        "properties": {
          "detail": {
            "title": "Detail",
            "type": "string"
          },
          "instance": {
            "title": "Instance",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "integer"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "type": {
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "instance"
        ],
        "title": "ProblemDetail",
        "type": "object"
      }
    }
  },
