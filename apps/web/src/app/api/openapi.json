              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Requested page size. Above 100 it is clamped to 100.",
              "title": "Pagesize"
            }
          },
          {
            "description": "The previous page's `nextPageToken`. Absent for the first page.",
            "in": "query",
            "name": "pageToken",
